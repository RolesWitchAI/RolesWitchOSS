    "%@" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@"
          }
        }
      }
    },
    "%@ %@/s" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ %2$@/s"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@/s"
          }
        }
      }
    },
    "%@ has no model configured. Open it in RolesWitch and pick one." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У «%@» не настроена модель. Откройте его в RolesWitch и выберите модель."
          }
        }
      }
    },
    "%@ is about %@ and downloads from the internet. Keep this screen open until it finishes." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ is about %2$@ and downloads from the internet. Keep this screen open until it finishes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» весит около %@ и скачивается из интернета. Не закрывайте этот экран до завершения."
          }
        }
      }
    },
    "%@ is hosted in a gated repository. Add a HuggingFace access token in Settings → Intelligence, and make sure your account has accepted the model's terms on huggingface.co." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ размещена в закрытом репозитории. Добавьте токен доступа HuggingFace в «Настройки → Интеллект» и убедитесь, что ваш аккаунт принял условия модели на huggingface.co."
          }
        }
      }
    },
    "%@ is not downloaded yet. Open RolesWitch and download it first." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» ещё не скачана. Откройте RolesWitch и скачайте её сначала."
          }
        }
      }
    },
